{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/universes/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/ticker/:path*", "destination": "/index.html" },
    { "source": "/financials", "destination": "/index.html" },
    { "source": "/financials/:path*", "destination": "/index.html" },
    { "source": "/options", "destination": "/index.html" },
    { "source": "/volume", "destination": "/index.html" },
    { "source": "/portfolios", "destination": "/index.html" }
  ]
}
